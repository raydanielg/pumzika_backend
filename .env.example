# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_BASE_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pumzika
DB_CONN_MAX_AGE=60

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- JWT ---
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
# JWT_SIGNING_KEY=  # defaults to SECRET_KEY

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Storage: local | s3 ---
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=          # e.g. http://minio:9000 or https://s3.amazonaws.com
AWS_S3_REGION_NAME=
AWS_QUERYSTRING_EXPIRE=3600

# --- Uploads ---
MAX_UPLOAD_SIZE_BYTES=10485760
MIN_IMAGE_DIMENSION=400
MAX_IMAGE_DIMENSION=8000

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@pumzika.africa

# --- SMS: console | africastalking | twilio ---
SMS_PROVIDER=console
SMS_SENDER_ID=PUMZIKA

# --- Payments: sandbox | production ---
PAYMENT_ENVIRONMENT=sandbox
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_BASE_URL=
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_BASE_URL=

# --- Observability ---
LOG_LEVEL=INFO
TIME_ZONE=Africa/Dar_es_Salaam

SELCOM_VENDOR_ID=
SELCOM_WEBHOOK_URL=
SELCOM_CONNECT_TIMEOUT=5
SELCOM_READ_TIMEOUT=20

GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
